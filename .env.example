# App credentials — the declaration manifest for this product's own secrets.
#
# Safe non-secret defaults may be committed. Secret values never belong in git:
# leave those entries empty, copy this file to .env (gitignored), and fill them
# there, or have the runtime inject them from a secret store.
#
# These are APP credentials: what the running product needs. They are distinct
# from the harness credentials that authenticate the agents building it, which
# are supplied to the build environment and never appear in this repository.
#
# Keep names role-based and provider-neutral (LLM_API_KEY, not OPENAI_API_KEY),
# so switching providers changes a value here and nothing in the code.

# --- Runtime ---
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# --- Add this product's own credentials below ---
# Every entry needs: what it is, where to get it, and which lifecycle steps
# need it. A name with no such note is a secret nobody can provision.
#
# Example:
# LLM_API_KEY=            # model provider key; needed from step 6 (build) onward
