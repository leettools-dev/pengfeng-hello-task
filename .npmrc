# leet-dev-guides is not on the public npm registry yet — it publishes to
# GitHub Packages under its own repo owner's scope (@pengfeng), not this
# product's. This mapping lets "npx @pengfeng/leet-dev-guides ..." (see the
# skills:install / lifecycle:instantiate / toolchain:lock / toolchain:verify
# scripts) resolve. A read:packages token still has to be present in the
# caller's npm auth (global ~/.npmrc or NODE_AUTH_TOKEN) — this file only
# routes the scope and forces that token to be sent.
@pengfeng:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:always-auth=true
